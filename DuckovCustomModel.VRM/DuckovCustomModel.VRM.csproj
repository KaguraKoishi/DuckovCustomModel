<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AssemblyName>DuckovCustomModel.VRM</AssemblyName>
		<RootNamespace>DuckovCustomModel.VRM</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<DuckovPath>D:\Saved Games\Platforms\Steam\steamapps\common\Escape from Duckov</DuckovPath>
	</PropertyGroup>

	<PropertyGroup>
		<UseGameLibsFromNuGet Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true' OR '$(UseGameLibsFromNuGet)' == 'true'">true</UseGameLibsFromNuGet>
		<UseGameLibsFromNuGet Condition="'$(UseGameLibsFromNuGet)' == ''">false</UseGameLibsFromNuGet>
	</PropertyGroup>

	<!-- CI 环境使用 NuGet 包 -->
	<ItemGroup Condition="'$(UseGameLibsFromNuGet)' == 'true'">
		<PackageReference Include="DuckovGameLibs" Version="2.0.26-Steam" />
	</ItemGroup>

	<!-- 本地开发使用游戏目录 -->
	<ItemGroup Condition="'$(UseGameLibsFromNuGet)' == 'false'">
		<Reference Include="$(DuckovPath)\Duckov_Data\Managed\TeamSoda.*">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovPath)\Duckov_Data\Managed\Unity*">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovPath)\Duckov_Data\Managed\Newtonsoft.Json.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovPath)\Duckov_Data\Managed\UniTask.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="UniGLTF">
			<HintPath>..\External\UniVRM\UniGLTF.dll</HintPath>
		</Reference>
		<Reference Include="UniGLTF.Utils">
			<HintPath>..\External\UniVRM\UniGLTF.Utils.dll</HintPath>
		</Reference>
		<Reference Include="UniGLTF.UniUnlit">
			<HintPath>..\External\UniVRM\UniGLTF.UniUnlit.dll</HintPath>
		</Reference>
		<Reference Include="UniHumanoid">
			<HintPath>..\External\UniVRM\UniHumanoid.dll</HintPath>
		</Reference>
		<Reference Include="VRM10">
			<HintPath>..\External\UniVRM\VRM10.dll</HintPath>
		</Reference>
		<Reference Include="VRM10.MToon10">
			<HintPath>..\External\UniVRM\VRM10.MToon10.dll</HintPath>
		</Reference>
		<Reference Include="FastSpringBone10">
			<HintPath>..\External\UniVRM\FastSpringBone10.dll</HintPath>
		</Reference>
		<Reference Include="SpringBoneJobs">
			<HintPath>..\External\UniVRM\SpringBoneJobs.dll</HintPath>
		</Reference>
		<Reference Include="VrmLib">
			<HintPath>..\External\UniVRM\VrmLib.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.4.1">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
	</ItemGroup>

	<ItemGroup>
  		<ProjectReference Include="..\DuckovCustomModel.Core\DuckovCustomModel.Core.csproj" />
  		<ProjectReference Include="..\DuckovCustomModel\DuckovCustomModel.csproj" />
	</ItemGroup>

</Project>
